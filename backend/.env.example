# ---- LLM (required for question generation + evaluation) ----
LLM_PROVIDER=gemini            # gemini | openai  (openai = any OpenAI-compatible endpoint)
GEMINI_API_KEY=your_actual_api_key
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Speech-to-text (runs locally with faster-whisper) ----
WHISPER_MODEL=base.en          # tiny.en | base.en | small.en | medium.en ; use 'base' etc. for other languages
WHISPER_LANGUAGE=en

# ---- Security ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=                   # the account registered with this email becomes admin

# ---- Storage / privacy ----
DATABASE_URL=sqlite:///./interview.db
MAX_UPLOAD_MB=200
RECORDING_RETENTION_DAYS=30    # media older than this is deleted at startup; 0 = keep until deleted by user
CORS_ORIGINS=http://localhost:5173
